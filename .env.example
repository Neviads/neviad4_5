# NEVIAD Physics environment
# Copy to .env and replace placeholders. Never commit .env.

# Ports: set only here. scripts/start.*, the backend and Next.js all read them from this file.
APP_PORT=8080
NEXT_PORT=3000

# Application
# Empty = http://localhost:NEXT_PORT
APP_CORS_ALLOWED_ORIGINS=
APP_LOG_LEVEL=INFO
# Python of the backend for scripts/start.*; empty = the conda env neviad-be if present, else be/.venv (created by the script)
NEVIAD_PYTHON=

# Supabase session pooler (copy values from Dashboard → Connect)
DB_URL='jdbc:postgresql://aws-<index>-<region>.pooler.supabase.com:5432/postgres?sslmode=require&prepareThreshold=0'
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
FLYWAY_ENABLED=true

# AI providers
APP_AI_OPENAI_API_KEY=your-openai-api-key
APP_AI_OPENAI_BASE_URL=https://api.openai.com
APP_AI_OPENAI_DEFAULT_MODEL=gpt-6-luna
APP_AI_DEEPSEEK_API_KEY=
APP_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
APP_AI_DEEPSEEK_DEFAULT_MODEL=

# Auth placeholders for the upcoming authentication module
APP_AUTH_GOOGLE_CLIENT_ID=
APP_AUTH_GOOGLE_CLIENT_SECRET=
APP_AUTH_JWT_SECRET=
APP_AUTH_COOKIE_SECURE=false

# Cloudflare R2 / S3-compatible storage
APP_R2_ENDPOINT=
APP_R2_ACCESS_KEY_ID=
APP_R2_SECRET_ACCESS_KEY=
APP_R2_BUCKET=neviad
APP_R2_PUBLIC_URL=

# Frontend: where the browser reaches the backend. Empty = http://localhost:APP_PORT and ws://localhost:APP_PORT/ws
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
